			return;
		}
		if(st == null){
			System.out.println("INVALID STUDENT ID");
			return;
		}
		map.computeIfAbsent(st, e -> new ArrayList<>()).add(book);
		
}

class student{
	private int student_id;
	private String name;
	private int borrowedBooks;
	student(student_id,name,borrowedBooks){
		this.student_id = student_id;
		this.name = name;
		this.borrowedBooks = borrowedBooks;
	}
	public int get_stu_id(){
		return this.student_id;
	}
	public String get_name(){
		return this.name;
	}
	public int borrowedBooks(){
		return this.borrowedBooks;
	}
}


class Book{
	private int book_id;
	private String title;
	private String author;
	private int copy;
	private int available_copy;
	Book(int book_id,String title,String author,int copy,int available_copy){
		this.book_id = book_id;
		this.title = title;
		this.author = author;
		this.copy = copy;
		this.available_copy = available_copy;
	}
	public int  get_book_id(){
		return this.book_id;
	}
	public String get_title(){
		return this.title;
	}
	public String get_author(){
		return this.author;
	}
	public int get_copy(){
		return this.copy;
	}
	public int get_ava_copy(){
		return this.available_copy;
	}
	
}
